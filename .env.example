# File: .env.example
# Copy to .env locally — NEVER commit real credentials to Git (Section 6)
YOUTUBE_API_KEY=your_api_key_here
YOUTUBE_CLIENT_SECRET_PATH=/path/to/outside/repo/client_secret.json
YOUTUBE_TOKEN_PATH=/path/to/outside/repo/token.json
YOUTUBE_DAILY_QUOTA_LIMIT=10000
YOUTUBE_PROVIDER_MODE=fixture